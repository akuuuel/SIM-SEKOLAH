# =========================================================================
# Web Absensi MAN 1 Bulukumba - Proteksi Direktori API & File Rahasia
# =========================================================================

# 1. Nonaktifkan Directory Browsing
Options -Indexes

# 2. Blokir Akses Langsung ke File Kunci, Konfigurasi & Data Rahasia
# Melindungi vapid.json (kunci privat push), .cnf, .key, .pem, .log, .sql, .env, dll.
<FilesMatch "\.(json|cnf|pem|key|log|sql|env|ini|sh|bak|md|git|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Blokir File Tersembunyi (Dotfiles)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Blokir Akses Web Langsung ke Skrip Helper Khusus CLI / Maintenance
<FilesMatch "^(make_ssl|generate_logo_assets)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
