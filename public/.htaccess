<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Jangan ganggu request API backend
  RewriteRule ^api/ - [L]

  # 2. Jangan ganggu file atau folder fisik yang memang ada (aset JS, CSS, gambar, sw.js, manifest)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Arahkan semua navigasi SPA lainnya ke index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Keamanan Tambahan: Nonaktifkan directory browsing & blokir file sensitif / tersembunyi
Options -Indexes
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Pengaturan Cache Header: sw.js tidak boleh di-cache oleh browser agar update langsung aktif di HP
<Files "sw.js">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</Files>
